{
	"name": "diloreto-website",
	"version": "2.0.0",
	"type": "module",
	"homepage": "https://diloreto.com",
	"private": true,
	"author": "Paul DiLoreto <soodohh@pm.me>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/soodoh/diloreto-website.git"
	},
	"bugs": {
		"url": "https://github.com/soodoh/diloreto-website/issues"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && bun scripts/finalize-static-output.ts",
		"start": "serve dist/client --listen 4173",
		"preview": "bun run start",
		"lint": "biome check .",
		"lint:fix": "biome check --fix .",
		"typecheck": "tsc --noEmit",
		"check:output": "bun scripts/assert-static-output.ts",
		"test:playwright": "bash scripts/test-playwright-docker.sh",
		"test:playwright:update": "bash scripts/test-playwright-docker.sh --update-snapshots",
		"test:smoke": "bash scripts/test-playwright-docker.sh tests/smoke.spec.ts",
		"check": "bun run lint && bun run typecheck && bun run build && bun run check:output && PLAYWRIGHT_SKIP_BUILD=1 bun run test:playwright",
		"prepare": "lefthook install"
	},
	"dependencies": {
		"@tanstack/react-router": "^1.170.18",
		"@tanstack/react-start": "^1.168.32",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"embla-carousel-react": "^8.6.0",
		"lucide-react": "^1.25.0",
		"radix-ui": "^1.6.4",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-markdown": "^10.1.0",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@commitlint/types": "^21.2.0",
		"@playwright/test": "^1.61.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"lefthook": "^2.1.10",
		"serve": "^14.2.6",
		"shadcn": "^4.13.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.1.5",
		"vite-imagetools": "^10.0.1"
	}
}
